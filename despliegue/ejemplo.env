# Copiar a /opt/eda/prod.env (y a /opt/eda/prueba.env con los valores de prueba) y completar.
# Los lee `docker compose --env-file …` (ver despliegue/LEEME.md).

# prod | prueba  (el nombre del contenedor: eda-prod / eda-prueba)
EDA_ENTORNO=prod

# el puerto TCP del server (prod 25900 · prueba 35900). Es el que va en `py jugar.py --server IP:PUERTO`
EDA_PUERTO=25900

# la IP PÚBLICA del VPS: prende el relay UDP (sin ella, sólo juegan clientes en la misma máquina)
EDA_RELAY_IP=

# el primer puerto UDP del relay (prod 26000 · prueba 36000); usa hasta EDA_RELAY_BASE + EDA_MAX_CONEXIONES
EDA_RELAY_BASE=26000
EDA_MAX_CONEXIONES=200

# dónde quedan las cuentas (una carpeta por entorno) y los XML del juego (compartidos)
EDA_ESTADO_DIR=/opt/eda/estado-prod
EDA_DATOS_DIR=/opt/eda/datos

# el texto del anuncio que se ve al abrir el juego (vacío = el de siempre)
EDA_ANUNCIO=

# claves de exes que no son los dos conocidos (hex, separadas por coma): md5(exe + byte 00)
EDA_CLAVES=
