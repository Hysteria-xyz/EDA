# Copiar a /opt/eda/prod.env (y a /opt/eda/prueba.env con los valores de prueba) y completar.
# Los lee `docker compose --env-file …` (ver despliegue/LEEME.md).

# prod | prueba  (el nombre del contenedor: eda-prod / eda-prueba)
EDA_ENTORNO=prod

# el puerto TCP del server (prod 25900 · prueba 35900). Es el que va en `py jugar.py --server IP:PUERTO`
EDA_PUERTO=25900

# la IP PÚBLICA del VPS: prende el relay UDP (sin ella, sólo juegan clientes en la misma máquina)
EDA_RELAY_IP=

# el primer puerto UDP del relay (prod 26000 · prueba 36000); usa hasta EDA_RELAY_BASE + EDA_MAX_CONEXIONES
EDA_RELAY_BASE=26000
EDA_MAX_CONEXIONES=200

# dónde quedan las cuentas (una carpeta por entorno). Es lo ÚNICO que hay que llevar al mudarse
EDA_ESTADO_DIR=/opt/eda/estado-prod

# el texto del anuncio que se ve al abrir el juego (vacío = el de siempre)
EDA_ANUNCIO=

# claves de exes que no son los dos conocidos (hex, separadas por coma): md5(exe + byte 00)
EDA_CLAVES=

# ★ el LOGIN (servidor/porteria.py, MEDICIONES §45):
#   abierto = cualquiera entra (cuentas rui/kai/mio/ren por orden de llegada: para probar)
#   pase    = sólo con el ticket que da POST /eda/pase a cambio del pase del portero de R2Beat
EDA_LOGIN=abierto
# el JWKS del portero (una URL https o un archivo dentro del contenedor)
EDA_PORTERO_CLAVES=
# …o la clave pública del servicio de cuentas DIRECTO (Ed25519: base64url de 32 bytes, o 64 hex). Si está, manda
#   sobre el JWKS y el server no sale a la red a buscar nada (así reciben la clave las demás piezas del conjunto)
EDA_CUENTAS_CLAVE_PUBLICA=
# el prefijo del nombre de la cuenta (vacío = r2b_). Con Cuenta Eñeños el número es el Eñeños ID: en_
EDA_PREFIJO_CUENTA=
# cómo nace la cuenta de quien entra con el pase por primera vez: vacío o `personaje` = con el personaje de
#   siempre ya hecho · `vacia` = sin personajes (los crea el jugador en la pantalla del juego)
EDA_CUENTA_NUEVA=
# ★ el pase que acepta este server (vacío = eda). El server de PRUEBA: eda-prueba (Cuenta Eñeños da ese pase aparte)
EDA_PORTERO_AUDIENCIA=
# el HTTP del login: por defecto EDA_PUERTO + 1, en 127.0.0.1. Afuera se publica con HTTPS
#   (Caddy u otro proxy en el VPS), porque el ticket es un secreto
EDA_HTTP_PUERTO=
# P2P entre casas (servidor/nat.py): 1 = los juegos se hablan directo con su IP pública real (como el
#   original); vacío = entre casas, todo por el relay. Medir primero en prueba: un NAT que no deja
#   pasar deja la sala en -1000
EDA_P2P_ENTRE_CASAS=
# ★ el camino de la partida: vacío = directo (lo de siempre) · relay = todo por el relay del server (más lento,
#   pero pasa cualquier NAT) · auto = por pareja: directo sólo si los dos NAT son confiables, si no relay
EDA_P2P=
# ★ los diagnósticos automáticos de los clientes beta (servidor/diag.py): 1 = recibirlos (SÓLO en prueba.env; en prod
#   vacío). Se guardan EDA_DIAG_DIAS días (14) y hasta EDA_DIAG_MAX_MB (500). Afuera van por HTTPS (caddy.sh)
EDA_DIAG=
EDA_DIAG_DIAS=
EDA_DIAG_MAX_MB=

# ★ EL PANEL DEL COORDINADOR EÑEÑOS (servidor/panel.py, despliegue/LEEME.md → «El panel del Coordinador»):
# la ficha interna: LA MISMA que R2_CUENTAS_FICHA_INTERNA del .env de Eñeños. Vacía = la puerta no existe (todo 404).
#   ⛔ es un secreto: sólo en el .env del VPS, nunca al repo
R2_CUENTAS_FICHA_INTERNA=
# un HTTP aparte, SÓLO con el panel, donde lo alcanza el contenedor del Coordinador (la red de Docker). Con la red del
#   VPS (network_mode: host) el HTTP del login escucha en 127.0.0.1, que desde otro contenedor no se alcanza. Va la IP
#   de la máquina en la red `bridge` de Docker (`docker network inspect bridge -f '{{(index .IPAM.Config 0).Gateway}}'`)
#   y el puerto: prod EDA_PUERTO + 2 (25902), prueba 35902. Vacío = sin HTTP aparte
EDA_PANEL_ESCUCHAR=
